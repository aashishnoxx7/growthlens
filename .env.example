# GrowthLens Configuration
# Copy this file to .env and fill in real values (never commit .env)

# ── Google Cloud ──────────────────────────────────────────────────────────────
# Your GCP project ID (billing-enabled) used to run BigQuery queries.
# The public dataset lives in bigquery-public-data; you only need your own
# project to authorize the query job.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional: path to a service-account key JSON file.
# Preferred method: run `gcloud auth application-default login` instead.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── BigQuery cost guardrails ──────────────────────────────────────────────────
# Maximum bytes billed per query (default: 10 GB = 10_000_000_000).
# Queries that would scan more data are rejected before execution.
BQ_MAX_BYTES_BILLED=10000000000

# ── Data paths ────────────────────────────────────────────────────────────────
# Directory where extracted / uploaded datasets are stored locally.
# DATA_DIR=data

# ── Application ───────────────────────────────────────────────────────────────
# Seed for reproducible synthetic-demo generation.
DEMO_RANDOM_SEED=42
